{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "AutoMigrate": false,
    "MigrationRetryCount": 10,
    "MigrationRetryDelaySeconds": 5
  },
  "Jwt": {
    "Issuer": "JiraLite",
    "Audience": "JiraLite",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14
  },
  "FileStorage": {
    "RootPath": "storage",
    "PublicBaseUrl": ""
  },
  "Invitations": {
    "ExpiryDays": 7
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 60,
    "ResetUrlTemplate": ""
  },
  "Mcp": {
    "Enabled": false,
    "ServerName": "JiraLite",
    "ServerVersion": "1.0.0"
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
